---
import { u } from '../lib/base.ts';
import '../styles/global.css';
import { data } from '../lib/data.ts';

interface Props {
  title: string;
  description?: string;
}
const { title, description = '住めない星も含め、一次ソースにある天体を「物件」として紹介し、生身で何秒もつか・どんな装備で住めるかを判定する宇宙の物件検索サイト。' } = Astro.props;
const { report } = data();
const fetched = report.fetchedAt.slice(0, 10);
const nav = [
  ['/search/', '物件検索'],
  ['/guided/', 'ガイド付き検索'],
  ['/catalog/', 'カタログ'],
  ['/compare/', '比較'],
  ['/ranking/', 'ランキング'],
  ['/learn/', '解説'],
  ['/method/', '判定方法と出典'],
];
const path = Astro.url.pathname;
const fullTitle = title === '宇宙物件ガイド' ? title : `${title}｜宇宙物件ガイド`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip sr-only" href="#main">本文へ移動</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={u('/')}>
          <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="9" fill="var(--accent)"></circle><ellipse cx="16" cy="16" rx="15" ry="5" fill="none" stroke="var(--tag)" stroke-width="2" transform="rotate(-20 16 16)"></ellipse></svg>
          <span>宇宙物件ガイド</span>
        </a>
        <button class="btn theme-toggle" type="button" aria-label="表示テーマを切り替える" data-theme-toggle>
          <span aria-hidden="true">◐</span><span class="theme-label">テーマ</span>
        </button>
      </div>
      <nav class="wrap nav" aria-label="メインメニュー">
        {nav.map(([href, label]) => <a href={u(href!)} aria-current={path.startsWith(u(href!)) ? 'page' : undefined}>{label}</a>)}
      </nav>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap small muted">
        <p>
          データは一次ソース（NASA NSSDC Planetary Fact Sheets、JPL Solar System Dynamics / Small-Body Database、NASA Exoplanet Archive ほか）から {fetched} に取得しました。
          全天体 {report.total.toLocaleString('ja-JP')} 件。数値の出典は各物件ページに記載しています。
        </p>
        <p>
          This research has made use of the NASA Exoplanet Archive, which is operated by the California Institute of Technology, under contract with the National Aeronautics and Space Administration under the Exoplanet Exploration Program.
        </p>
        <p>
          企画の参考：ゆる天文学ラジオ「移住マイスター」シリーズ（YouTube）。本サイトの文章は独自に書いたもので、動画の内容と異なる点は<a href={u('/method/#factcheck')}>ファクトチェック</a>に記載しています。
        </p>
      </div>
    </footer>
    <script is:inline>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>

<style>
  .skip:focus {
    position: static;
    width: auto;
    height: auto;
    clip: auto;
    padding: 8px;
  }
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    margin-bottom: 24px;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 10px;
    padding-bottom: 6px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--ink);
    text-decoration: none;
  }
  .theme-toggle {
    padding: 6px 10px;
    font-size: 0.85rem;
  }
  .nav {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    padding-bottom: 6px;
    scrollbar-width: thin;
  }
  .nav a {
    flex: none;
    padding: 6px 10px;
    border-radius: 8px;
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .nav a:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  .nav a[aria-current='page'] {
    background: var(--accent-wash);
    color: var(--accent-ink);
    font-weight: 600;
  }
  main {
    min-height: 60vh;
    padding-bottom: 48px;
  }
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 24px 0 32px;
  }
  @media (max-width: 480px) {
    .theme-label {
      display: none;
    }
  }
</style>
