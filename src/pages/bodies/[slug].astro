---
import { u } from '../../lib/base.ts';
import BodyCard from '../../components/BodyCard.astro';
import Equip from '../../components/Equip.astro';
import Glyph from '../../components/Glyph.astro';
import V from '../../components/V.astro';
import { CURATED } from '../../data/curated.ts';
import Base from '../../layouts/Base.astro';
import { autoText } from '../../lib/autotext.ts';
import { data, url } from '../../lib/data.ts';
import {
  ATM_JA, CATEGORY_JA, HZ_JA, ROCKY_JA, SURVIVAL_JA, TRAVEL_SPEEDS, displayName, fmt, fmtDays, fmtHours, fmtLy, fmtTemp, travelYears,
} from '../../lib/format.ts';
import type { Body, Val } from '../../lib/types.ts';

export function getStaticPaths() {
  return data().bodies.map((b) => ({ params: { slug: b.slug } }));
}

const { slug } = Astro.params;
const { bySlug, sources, sysBySlug } = data();
const b = bySlug.get(slug!) as Body;
const c = CURATED[b.slug];
const auto = autoText(b);
const name = displayName(b);

// ---- footnotes
const order: string[] = [];
const fn = (id?: string) => {
  if (!id || !sources[id]) return undefined;
  let i = order.indexOf(id);
  if (i < 0) {
    order.push(id);
    i = order.length - 1;
  }
  return i + 1;
};

type Row = { label: string; v: Val; text: string; fn?: number };
const row = (label: string, v: Val | undefined, text: (x: number) => string): Row | null => (v ? { label, v, text: v.v != null ? text(v.v) : '', fn: fn(v.src) } : null);

const rows: (Row | null)[] = [
  row('半径', b.radiusE, (x) => (b.category === 'small' || b.category === 'comet' || x < 0.01 ? `${fmt(x * 6371 * 2, 1)} km（直径）` : `地球の ${fmt(x)} 倍（${fmt(x * 6371, 0)} km）`)),
  row('質量', b.massE, (x) => `地球の ${fmt(x)} 倍`),
  row('表面重力', b.gravityG, (x) => `地球の ${fmt(x)} 倍`),
  row('平均密度', b.densityGcc, (x) => `${fmt(x, 2)} g/cm³`),
  row('脱出速度', b.escapeKmS, (x) => `${fmt(x)} km/s`),
  row('1日の長さ', b.rotationH, (x) => fmtHours(x)),
  row(b.category === 'moon' ? '公転周期（惑星のまわり）' : '1年（公転周期）', b.orbitalPeriodD, (x) => fmtDays(x)),
  b.category === 'moon' ? row('惑星からの距離', b.moonAKm, (x) => `${fmt(x, 0)} km`) : null,
  b.category !== 'star' ? row(b.system === 'solar' ? '太陽からの距離（軌道長半径）' : '恒星からの距離（軌道長半径）', b.aAU, (x) => `${fmt(x)} au`) : null,
  row('離心率', b.ecc, (x) => fmt(x, 3)),
  row('自転軸の傾き', b.obliquityDeg, (x) => `${fmt(x, 1)}°`),
  row('平均気温', b.tempMeanK, (x) => fmtTemp(x)),
  row('最低気温', b.tempMinK, (x) => fmtTemp(x)),
  row('最高気温', b.tempMaxK, (x) => fmtTemp(x)),
  b.category !== 'star' ? row('放射平衡温度', b.tempEqK, (x) => fmtTemp(x)) : null,
  b.category !== 'star' ? row('受け取る光の量', b.insolE, (x) => `地球の ${fmt(x)} 倍`) : null,
  b.category !== 'star' ? row('表面気圧', b.pressureBar, (x) => `${fmt(x)} bar`) : null,
  row('アルベド（反射率）', b.albedo, (x) => fmt(x, 2)),
  b.moonCount ? row('衛星の数', b.moonCount, (x) => `${fmt(x, 0)} 個`) : null,
  b.system !== 'solar' ? row('地球からの距離', b.distanceLy, (x) => fmtLy(x)) : null,
];
const shown = rows.filter((r): r is Row => r != null && !(r.v.c === 'unknown' && !r.v.note && (r.label === '最低気温' || r.label === '最高気温' || r.label === 'アルベド（反射率）' || r.label === '自転軸の傾き' || r.label === '脱出速度')));

const gasesFn = fn(b.gasesSrc);
const hazardsFn = fn(b.hazardsSrc);
const tidalFn = fn(b.tidalLockSrc);
const survivalFns = b.survival.sourceIds.map((id) => fn(id)).filter((x): x is number => x != null);
const refFns = (c?.refs ?? []).map((id) => fn(id)).filter((x): x is number => x != null);
const hostRows = b.host
  ? [
      row('主星の有効温度', b.host.teffK, (x) => `${fmt(x, 0)} K`),
      row('主星の半径', b.host.radiusSun, (x) => `太陽の ${fmt(x)} 倍`),
      row('主星の質量', b.host.massSun, (x) => `太陽の ${fmt(x)} 倍`),
      row('主星の明るさ', b.host.lumLogSun, (x) => `太陽の ${fmt(10 ** x)} 倍`),
    ].filter((r): r is Row => r != null && r.v.v != null)
  : [];
const sys = sysBySlug.get(b.system);
const parent = b.parent ? bySlug.get(b.parent) : undefined;
const siblings = (sys?.members ?? []).filter((s) => s !== b.slug).slice(0, 12).map((s) => bySlug.get(s)!).filter(Boolean);
const moons = b.category === 'planet' || b.category === 'dwarf' ? data().bodies.filter((x) => x.parent === b.slug) : [];
const bigMoons = moons.filter((m) => m.radiusE.v != null).sort((a, z) => (z.radiusE.v ?? 0) - (a.radiusE.v ?? 0)).slice(0, 8);
if (b.system !== 'solar') fn('nea');

const tags = [...(c?.tags ?? []), ...auto.tags.filter((t) => !(c?.tags ?? []).includes(t))];
const pros = c?.pros ?? auto.pros;
const cons = c?.cons ?? auto.cons;
const life = [...(c?.earthLife ?? []), ...auto.earthLife];
const lead = c?.catchphrase ?? auto.summary;
const consc = b.survival.consciousSec;
const desc = `${name}（${CATEGORY_JA[b.category]}）：${lead}`;
---

<Base title={`${name}`} description={desc.slice(0, 160)}>
  <nav class="crumbs small" aria-label="パンくず">
    <a href={u('/')}>トップ</a> › <a href={u(`/catalog/${b.category}/`)}>{CATEGORY_JA[b.category]}</a>
    {sys && b.system !== 'solar' && (<> › <a href={url.system(sys.slug)}>{sys.name} 系</a></>)}
    {parent && (<> › <a href={url.body(parent.slug)}>{displayName(parent)}</a></>)}
  </nav>

  <header class="hero">
    <Glyph body={b} size={120} />
    <div>
      <p class="kicker small">{CATEGORY_JA[b.category]}{b.subclass ? `・${b.subclass}` : ''}{b.discoveryYear ? `・${b.discoveryYear}年発見` : ''}</p>
      <h1>{name}</h1>
      {b.nameJa && <p class="en muted">{b.name}</p>}
      <p class="lead">{lead}</p>
      {tags.length > 0 && <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>}
    </div>
  </header>
  {b.dataWarnings && b.dataWarnings.length > 0 && <p class="card warn small" role="note"><b>データに要注意：</b>{b.dataWarnings.join(' ')}</p>}
  <p class="small muted glyph-note">左の図はデータから描いた模式図で、実際の画像ではありません。{c ? '' : 'このページの説明文はデータから自動生成しています。'}</p>

  <section class="grid grid-3 verdicts" aria-label="判定">
    <div class="card verdict">
      <h2 class="vh">生身で放り出されたら</h2>
      <p class="big">{b.survival.cause === 'earth' ? '生活できます' : b.survival.cause === 'heat' ? (consc && consc[1] <= 1 ? '即死（高温）' : '数秒以内（高温）') : consc ? (consc[1] <= 1 ? '即死' : `約${consc[0]}〜${consc[1]}秒で意識を失う`) : SURVIVAL_JA[b.survival.cause]}</p>
      <p class="small">{b.survival.summary}{survivalFns.map((n) => <sup><a href={`#src-${n}`}>[{n}]</a></sup>)}</p>
    </div>
    <div class="card verdict">
      <h2 class="vh">入居条件</h2>
      <p class="big"><Equip eq={b.equipment} /></p>
      <p class="small">{b.equipment.reason}</p>
    </div>
    <div class="card verdict">
      <h2 class="vh">立地</h2>
      <p class="big">{b.category === 'star' ? '太陽系の中心' : HZ_JA[b.hz.status]}</p>
      <p class="small">
        {b.hz.innerAU != null && b.category !== 'star' && <>保守的なハビタブルゾーンは {fmt(b.hz.innerAU, b.hz.innerAU! < 0.1 ? 3 : 2)}〜{fmt(b.hz.outerAU, b.hz.outerAU! < 0.1 ? 3 : 2)} au（楽観的 {fmt(b.hz.optInnerAU, b.hz.optInnerAU! < 0.1 ? 3 : 2)}〜{fmt(b.hz.optOuterAU, b.hz.optOuterAU! < 0.1 ? 3 : 2)} au）。{b.aAU.v != null && <>この物件は {fmt(b.aAU.v)} au。</>}</>}
        {b.hz.extrapolated && <>主星の温度がモデルの適用範囲外のため参考値です。</>}
        {b.hz.status === 'unknown' && b.category !== 'star' && (b.system === 'solar' ? <>軌道が双曲線で、太陽からの平均距離が定まらないため判定できません。</> : <>主星の温度・明るさ、または軌道が分からないため判定できません。</>)}
      </p>
    </div>
  </section>

  <div class="cols">
    <section>
      <h2>メリット</h2>
      {pros.length ? <ul>{pros.map((p) => <li>{p}</li>)}</ul> : <p class="muted">特筆すべきメリットは見つかりませんでした。</p>}
      <h2>デメリット（注意事項）</h2>
      {cons.length ? <ul>{cons.map((p) => <li>{p}</li>)}</ul> : <p class="muted">データから分かる注意事項はありません。</p>}
      {c?.origin && (<><h2>名前の由来</h2><p>{c.origin}</p></>)}
      {life.length > 0 && (<><h2>地球人の暮らしに置き換えると</h2><ul>{life.map((p) => <li>{p}</li>)}</ul></>)}
      {refFns.length > 0 && <p class="small muted">この説明文の出典：{refFns.map((n) => <a href={`#src-${n}`}>[{n}]</a>)}</p>}
    </section>

    <section>
      <h2>間取り（基本データ）</h2>
      <div class="table-scroll">
        <table class="spec">
          <tbody>
            {shown.map((r) => (<tr><th scope="row">{r.label}</th><td><V v={r.v} text={r.text} fn={r.fn} /></td></tr>))}
            <tr><th scope="row">地表</th><td>{ROCKY_JA[b.rocky]}</td></tr>
            <tr><th scope="row">大気</th><td>{ATM_JA[b.atmosphere]}{b.gases.length > 0 && <>：{b.gases.map((g) => `${g.gas}${g.pct != null ? ` ${g.pct}%` : ''}`).join('、')}</>}{gasesFn && <sup><a href={`#src-${gasesFn}`}>[{gasesFn}]</a></sup>}</td></tr>
            {b.tidalLock !== 'unknown' && <tr><th scope="row">潮汐固定</th><td>{b.tidalLock === 'yes' ? 'いつも同じ面を向けている' : b.tidalLock === 'likely' ? '同じ面を向けている可能性が高い' : 'なし'}{tidalFn && <sup><a href={`#src-${tidalFn}`}>[{tidalFn}]</a></sup>}</td></tr>}
            {b.dimensionsKm && <tr><th scope="row">形（3軸）</th><td>{b.dimensionsKm}</td></tr>}
            {b.hazards.length > 0 && <tr><th scope="row">注意</th><td>{b.hazards.map((h) => (h === 'radiation' ? '強い放射線' : h === 'stellar-xuv' ? '主星からの強い紫外線・X線' : h)).join('、')}{hazardsFn && <sup><a href={`#src-${hazardsFn}`}>[{hazardsFn}]</a></sup>}</td></tr>}
            {b.designation && <tr><th scope="row">符号</th><td>{b.designation}</td></tr>}
            {b.discoveredBy && <tr><th scope="row">発見</th><td>{b.discoveryYear ? `${b.discoveryYear}年・` : ''}{b.discoveredBy}</td></tr>}
            {b.esi != null && <tr><th scope="row">ESI（地球類似性指標）</th><td><span class="num">{fmt(b.esi, 3)}</span><span class="badge-conf" data-c="derived">本サイト計算</span> <a class="small" href={u('/learn/#esi')}>計算方法</a></td></tr>}
            {b.jwstObservations && <tr><th scope="row">JWST 観測</th><td>{b.jwstObservations} 回（アーカイブ登録数）</td></tr>}
          </tbody>
        </table>
      </div>

      {hostRows.length > 0 && (
        <>
          <h3>主星 {b.host!.name}{b.host!.spectralType ? `（${b.host!.spectralType}）` : ''}</h3>
          <table class="spec"><tbody>{hostRows.map((r) => <tr><th scope="row">{r.label}</th><td><V v={r.v} text={r.text} fn={r.fn} /></td></tr>)}</tbody></table>
        </>
      )}

      {b.distanceLy.v != null && b.system !== 'solar' && (
        <>
          <h3>アクセス（到着までの時間）</h3>
          <table class="spec">
            <tbody>{TRAVEL_SPEEDS.map((s) => <tr><th scope="row">{s.label}</th><td class="num">{travelYears(b.distanceLy.v!, s.c)}</td></tr>)}</tbody>
          </table>
          <p class="small muted">加速・減速の時間は考えていません。</p>
        </>
      )}
    </section>
  </div>

  {c?.changelog && c.changelog.length > 0 && (
    <section>
      <h2>情報の更新履歴・ファクトチェック</h2>
      <ul class="changelog">{c.changelog.map((e) => <li><time>{e.date}</time> {e.text}</li>)}</ul>
    </section>
  )}

  {bigMoons.length > 0 && (
    <section>
      <h2>主な衛星（全{moons.length}個）</h2>
      <div class="grid grid-cards">{bigMoons.map((m) => <BodyCard body={m} />)}</div>
      <p class="small"><a href={u(`/catalog/moon/?p=${b.slug}`)}>{displayName(b)}の衛星をすべて見る</a></p>
    </section>
  )}

  {siblings.length > 0 && b.system !== 'solar' && (
    <section>
      <h2>同じ恒星系の物件</h2>
      <div class="grid grid-cards">{siblings.map((s) => <BodyCard body={s} />)}</div>
      <p class="small"><a href={url.system(b.system)}>{b.systemName} 系の全体図を見る</a></p>
    </section>
  )}

  <section>
    <h2>出典</h2>
    <ol class="sources small">
      {order.map((id, i) => (
        <li id={`src-${i + 1}`}><a href={u(sources[id]!.url)} rel="noopener">{sources[id]!.label}</a></li>
      ))}
    </ol>
    {b.system !== 'solar' && sys?.overviewUrl && <p class="small"><a href={sys.overviewUrl} rel="noopener">NASA Exoplanet Archive で {b.systemName} の概要を見る</a></p>}
    <p class="small muted">「実測」は一次ソースが報告した値、「計算値」は一次ソース自身が計算した値、「本サイト計算」は一次ソースの値から本サイトが計算した値です（<a href={u('/method/')}>判定方法</a>）。</p>
  </section>
</Base>

<style>
  .crumbs {
    margin-bottom: 12px;
    color: var(--ink-2);
  }
  .hero {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }
  .kicker {
    margin: 0 0 4px;
    color: var(--tag-ink);
    font-weight: 600;
  }
  .hero h1 {
    margin-bottom: 0;
  }
  .en {
    margin: 0 0 8px;
  }
  .lead {
    font-size: 1.1rem;
    margin: 8px 0 12px;
  }
  .glyph-note {
    margin-top: 8px;
  }
  .warn {
    border-color: var(--serious);
    margin: 12px 0 0;
  }
  .verdicts {
    margin: 16px 0 8px;
  }
  .vh {
    font-size: 0.9rem;
    color: var(--ink-2);
    margin: 0 0 4px;
    font-weight: 600;
  }
  .big {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0 0 6px;
  }
  .verdict .small {
    margin: 0;
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 32px;
  }
  .spec th {
    width: 38%;
    font-weight: 500;
  }
  .changelog time {
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    margin-right: 6px;
  }
  .sources li {
    margin-bottom: 4px;
  }
  ul {
    padding-left: 1.2em;
  }
  li {
    margin-bottom: 4px;
  }
  @media (max-width: 820px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
  @media (max-width: 560px) {
    .hero {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
