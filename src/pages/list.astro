---
import { u } from '../lib/base.ts';
import BodyTable from '../components/BodyTable.astro';
import Equip from '../components/Equip.astro';
import Base from '../layouts/Base.astro';
import { data } from '../lib/data.ts';
import { CATEGORY_JA } from '../lib/format.ts';
import type { EquipmentLevel } from '../lib/types.ts';

const { bySlug, report, bodies } = data();
const pick = (slugs: string[]) => slugs.map((s) => bySlug.get(s)!).filter(Boolean);
const series = [
  { title: '惑星', items: pick(['mercury', 'venus', 'earth', 'mars', 'jupiter', 'saturn', 'uranus', 'neptune']) },
  { title: '準惑星', items: pick(['ceres', 'pluto', 'haumea', 'makemake', 'eris']) },
  { title: '主な衛星', items: pick(['moon', 'titan', 'europa', 'enceladus', 'io', 'ganymede']) },
  { title: '主な系外惑星', items: pick(['proxima-cen-b', 'teegardens-star-b', 'trappist-1-e', 'kepler-22-b', 'corot-7-b', 'toi-700-d']) },
];
const levels: (EquipmentLevel | null)[] = [0, 1, 2, 3, 4, null];
const levelCount = (l: EquipmentLevel | null) => bodies.filter((b) => b.equipment.level === l).length;
const levelExample: Record<string, string> = { '0': '地球', '1': 'タイタン', '2': '月・火星・冥王星', '3': '水星・イオ・エウロパ', '4': '金星・木星・太陽', null: '大気が分からない系外惑星' };
const cats = Object.entries(report.byCategory).filter(([, n]) => n > 0);
---

<Base title="一覧">
  <h1>一覧</h1>
  <p class="lead">{report.total.toLocaleString('ja-JP')} 天体を掲載。宇宙服なしで何秒もつか、どの装備で住めるかを一次ソースのデータで判定しています。</p>
  <ul class="cats">
    {cats.map(([c, n]) => (
      <li><a href={u(`/catalog/${c}/`)}>{CATEGORY_JA[c as keyof typeof CATEGORY_JA]}</a> <span class="num muted">{n.toLocaleString('ja-JP')}</span></li>
    ))}
  </ul>

  {series.map((s) => (
    <section>
      <h2>{s.title}</h2>
      <BodyTable bodies={s.items} />
    </section>
  ))}

  <section>
    <h2>装備レベル</h2>
    <div class="table-scroll rwrap">
      <table class="rtable">
        <thead><tr><th>レベル</th><th>例</th><th class="num">件数</th></tr></thead>
        <tbody>
          {levels.map((l) => (
            <tr>
              <td class="rt-title"><Equip eq={{ level: l, minLevel: 2 }} /></td>
              <td data-label="例">{levelExample[String(l)]}</td>
              <td class="num" data-label="件数">{levelCount(l).toLocaleString('ja-JP')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="small"><a href={u('/method/#equipment')}>判定ルール</a></p>
  </section>
</Base>

<style>
  .lead {
    max-width: 46em;
  }
  .cats {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }
</style>
