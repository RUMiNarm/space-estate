---
import '../styles/global.css';
import { u } from '../lib/base.ts';
const links: [string, string][] = [
  ['/list/', '一覧'],
  ['/search/', '物件検索'],
  ['/guided/', 'ガイド付き検索'],
  ['/compare/', '比較'],
  ['/ranking/', 'ランキング'],
  ['/learn/', '解説'],
  ['/method/', '判定方法と出典'],
];
---

<!doctype html>
<html lang="ja" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>宇宙物件ガイド</title>
    <meta name="description" content="太陽系から天の川銀河まで、3D の宇宙を回って住めるかどうかを調べる宇宙の物件検索。" />
    <meta property="og:title" content="宇宙物件ガイド" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body class="explorer">
    <div id="stage" class="stage"></div>
    <div id="labels" class="labels" aria-hidden="true"></div>
    <div class="warp" id="warp" aria-hidden="true"></div>

    <header class="tl">
      <a class="brand" href={u('/list/')} title="一覧で見る">
        <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="9" fill="#3987e5"></circle><ellipse cx="16" cy="16" rx="15" ry="5" fill="none" stroke="#d95926" stroke-width="2" transform="rotate(-20 16 16)"></ellipse></svg>
        <span>宇宙物件ガイド</span>
      </a>
      <button class="ic back" id="back" type="button" aria-label="ひとつ上の階層へ" hidden>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
    </header>

    <nav class="tr">
      <button class="ic" id="menuBtn" type="button" aria-label="メニュー" aria-expanded="false" aria-controls="menu">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path></svg>
      </button>
      <div class="menu" id="menu" hidden>
        {links.map(([href, label]) => <a href={u(href)}>{label}</a>)}
      </div>
    </nav>

    <ol class="ladder" id="ladder" aria-label="スケール">
      <li><button type="button" data-go="galaxy">銀河</button></li>
      <li><button type="button" data-go="stars">恒星</button></li>
      <li><button type="button" data-go="solar">太陽系</button></li>
      <li class="leaf" hidden><button type="button" data-go="leaf" id="leaf"></button></li>
    </ol>

    <div class="br">
      <span class="date num" id="date"></span>
      <button class="ic" id="pause" type="button" aria-label="時間を止める" aria-pressed="false">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="i-pause"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path></svg>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="i-play"><path d="M8 5l11 7-11 7z" fill="currentColor"></path></svg>
      </button>
    </div>

    <div class="hint" id="hint" aria-hidden="true">
      <span><svg viewBox="0 0 24 24" width="26" height="26"><path d="M7 11c0-3 2-5 5-5s5 2 5 5v4a5 5 0 0 1-10 0z M12 6v4" fill="none" stroke="currentColor" stroke-width="1.6"></path><path d="M3 12h2M19 12h2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg><span class="t-mouse">ドラッグ</span><span class="t-touch">スワイプ</span></span>
      <span><svg viewBox="0 0 24 24" width="26" height="26"><rect x="7" y="4" width="10" height="16" rx="5" fill="none" stroke="currentColor" stroke-width="1.6"></rect><path d="M12 7v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg><span class="t-mouse">スクロール</span><span class="t-touch">ピンチ</span></span>
    </div>

    <div class="card-h" id="card" hidden>
      <b id="cardName"></b>
      <span id="cardSub" class="sub"></span>
      <span class="row"><span id="cardLv"></span><span id="cardAct" class="act"></span></span>
    </div>

    <p class="foot">距離と大きさは誇張・模式図　<a href={u('/method/')}>データの出典</a></p>

    <noscript><p class="fallback">3D 表示には JavaScript が必要です。<a href={u('/list/')}>一覧で見る</a></p></noscript>
    <p class="fallback" id="nogl" hidden>この環境では 3D を表示できません。<a href={u('/list/')}>一覧で見る</a></p>

    <script>
      import { startExplorer, type Level } from '../explorer/app.ts';
      import { EQUIP } from '../lib/format.ts';

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const card = $('card');
      const warpEl = $('warp');
      const back = $<HTMLButtonElement>('back');
      const leaf = $<HTMLButtonElement>('leaf');
      const dateEl = $('date');
      const pauseBtn = $<HTMLButtonElement>('pause');
      let lastDate = '';

      const hud = {
        setLevel(level: Level, name?: string) {
          const top = level === 'planet' || level === 'system' ? (level === 'planet' ? 'solar' : 'stars') : level;
          document.querySelectorAll<HTMLButtonElement>('#ladder button[data-go]').forEach((b) => b.classList.toggle('on', b.dataset.go === top));
          leaf.parentElement!.hidden = !(level === 'planet' || level === 'system');
          leaf.textContent = name ?? '';
          leaf.classList.toggle('on', level === 'planet' || level === 'system');
          leaf.parentElement!.dataset.under = level === 'planet' ? 'solar' : 'stars';
          back.hidden = level === 'solar';
          document.body.dataset.level = level;
        },
        setDate(jd: number | null) {
          const s = jd == null ? '' : new Date((jd - 2440587.5) * 86400000).toISOString().slice(0, 10);
          if (s !== lastDate) dateEl.textContent = lastDate = s;
        },
        hover(p: { label: string; sub?: string; eq?: number | null; kind: 'open' | 'zoom' } | null, x: number, y: number) {
          if (!p) {
            card.hidden = true;
            return;
          }
          card.hidden = false;
          $('cardName').textContent = p.label;
          $('cardSub').textContent = p.sub ?? '';
          const lv = $('cardLv');
          if (p.eq !== undefined) {
            const e = EQUIP[p.eq === null ? 'null' : (p.eq as 0 | 1 | 2 | 3 | 4)];
            lv.innerHTML = `<span class="dot" style="background:${e.color}"></span>${e.icon} ${e.short}`;
          } else lv.textContent = '';
          $('cardAct').textContent = p.kind === 'zoom' ? '⊕' : '↗';
          const W = innerWidth;
          card.style.transform = `translate(${Math.min(x + 16, W - 220)}px, ${y + 16}px)`;
        },
        warp() {
          warpEl.classList.remove('go');
          void warpEl.offsetWidth;
          warpEl.classList.add('go');
        },
        setPaused(p: boolean) {
          pauseBtn.setAttribute('aria-pressed', String(p));
          pauseBtn.setAttribute('aria-label', p ? '時間を進める' : '時間を止める');
        },
      };

      const gl = (() => {
        try {
          return !!document.createElement('canvas').getContext('webgl2');
        } catch {
          return false;
        }
      })();
      if (!gl) $('nogl').hidden = false;
      else {
        const app = await startExplorer($('stage'), $('labels'), hud);
        (window as unknown as { __explorer: typeof app }).__explorer = app;
        back.addEventListener('click', () => app.back());
        pauseBtn.addEventListener('click', () => app.togglePause());
        document.querySelectorAll<HTMLButtonElement>('#ladder button[data-go]').forEach((b) =>
          b.addEventListener('click', () => {
            const g = b.dataset.go!;
            if (g === 'leaf') app.openFocused();
            else void app.go(g as Level);
          }),
        );
        const menuBtn = $<HTMLButtonElement>('menuBtn');
        const menu = $('menu');
        menuBtn.addEventListener('click', () => {
          menu.hidden = !menu.hidden;
          menuBtn.setAttribute('aria-expanded', String(!menu.hidden));
        });
        const hint = $('hint');
        const hide = () => hint.classList.add('gone');
        setTimeout(hide, 5000);
        $('stage').addEventListener('pointerdown', hide, { once: true });
        $('stage').addEventListener('wheel', hide, { once: true, passive: true });
      }
    </script>
  </body>
</html>

<style is:global>
  body.explorer {
    margin: 0;
    overflow: hidden;
    background: #03040a;
    color: #e9eef7;
    height: 100dvh;
    overscroll-behavior: none;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .stage {
    position: fixed;
    inset: 0;
  }
  .stage canvas {
    display: block;
    cursor: grab;
    outline: none;
  }
  .stage canvas:active {
    cursor: grabbing;
  }
  .labels {
    position: fixed;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .lbl {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: rgba(233, 238, 247, 0.82);
    text-shadow: 0 0 6px #000, 0 0 2px #000;
    white-space: nowrap;
    will-change: transform;
  }
  .lbl.dim {
    color: rgba(190, 200, 220, 0.55);
    font-size: 11px;
  }
  .lbl.moon {
    font-size: 11px;
    color: rgba(200, 220, 255, 0.85);
  }
  .lbl.star {
    font-size: 10.5px;
    color: rgba(255, 236, 205, 0.7);
  }
  .lbl.scale {
    font-size: 10.5px;
    color: rgba(150, 170, 205, 0.6);
  }
  .lbl.home {
    color: #ffd27a;
    font-weight: 600;
  }
  .explorer .ic {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(12, 16, 28, 0.55);
    backdrop-filter: blur(8px);
    color: #e9eef7;
    cursor: pointer;
  }
  .explorer .ic[hidden] {
    display: none;
  }
  .explorer .ic:hover {
    border-color: rgba(140, 180, 255, 0.6);
  }
  .tl {
    position: fixed;
    top: max(12px, env(safe-area-inset-top));
    left: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #e9eef7;
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.06em;
    padding: 6px 10px;
    border-radius: 12px;
    background: rgba(12, 16, 28, 0.45);
    backdrop-filter: blur(8px);
  }
  .tr {
    position: fixed;
    top: max(12px, env(safe-area-inset-top));
    right: 12px;
  }
  .menu {
    position: absolute;
    right: 0;
    top: 48px;
    display: grid;
    min-width: 180px;
    padding: 6px;
    border-radius: 14px;
    background: rgba(12, 16, 28, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
  }
  .menu[hidden] {
    display: none;
  }
  .menu a {
    color: #e9eef7;
    text-decoration: none;
    padding: 9px 12px;
    border-radius: 10px;
    font-size: 14px;
  }
  .menu a:hover {
    background: rgba(255, 255, 255, 0.08);
  }
  .ladder {
    position: fixed;
    left: 12px;
    bottom: max(16px, env(safe-area-inset-bottom));
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ladder li[hidden] {
    display: none;
  }
  .ladder button {
    font: inherit;
    font-size: 12.5px;
    letter-spacing: 0.08em;
    color: rgba(233, 238, 247, 0.55);
    background: none;
    border: 0;
    padding: 4px 10px 4px 14px;
    border-left: 2px solid rgba(255, 255, 255, 0.15);
    cursor: pointer;
    text-align: left;
  }
  .ladder button:hover {
    color: #fff;
  }
  .ladder button.on {
    color: #fff;
    border-left-color: #3987e5;
    font-weight: 700;
  }
  .ladder .leaf button {
    padding-left: 26px;
  }
  .ladder .leaf button::after {
    content: ' ↗';
    color: #86b6ef;
  }
  .br {
    position: fixed;
    right: 12px;
    bottom: max(16px, env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .date {
    font-size: 13px;
    letter-spacing: 0.08em;
    color: rgba(233, 238, 247, 0.7);
    font-variant-numeric: tabular-nums;
  }
  #pause .i-play,
  #pause[aria-pressed='true'] .i-pause {
    display: none;
  }
  #pause[aria-pressed='true'] .i-play {
    display: block;
  }
  body[data-level='stars'] .br,
  body[data-level='galaxy'] .br {
    visibility: hidden;
  }
  .hint {
    position: fixed;
    left: 50%;
    bottom: 64px;
    transform: translateX(-50%);
    display: flex;
    gap: 22px;
    font-size: 12px;
    color: rgba(233, 238, 247, 0.6);
    transition: opacity 0.8s;
    pointer-events: none;
  }
  .hint > span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .hint .t-touch {
    display: none;
  }
  @media (pointer: coarse) {
    .hint .t-touch {
      display: inline;
    }
    .hint .t-mouse {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .hint {
      bottom: 150px;
    }
  }
  .hint.gone {
    opacity: 0;
  }
  .card-h {
    position: fixed;
    left: 0;
    top: 0;
    display: grid;
    gap: 2px;
    min-width: 140px;
    max-width: 220px;
    padding: 8px 12px;
    border-radius: 12px;
    background: rgba(10, 14, 26, 0.82);
    border: 1px solid rgba(140, 180, 255, 0.25);
    backdrop-filter: blur(8px);
    pointer-events: none;
    font-size: 12px;
  }
  .card-h[hidden] {
    display: none;
  }
  .card-h b {
    font-size: 14px;
  }
  .card-h .sub {
    color: rgba(200, 212, 235, 0.7);
  }
  .card-h .sub:empty {
    display: none;
  }
  .card-h .row {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: center;
  }
  .card-h .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 4px;
  }
  .card-h .act {
    color: #86b6ef;
    font-size: 15px;
  }
  .foot {
    position: fixed;
    left: 50%;
    bottom: max(6px, env(safe-area-inset-bottom));
    transform: translateX(-50%);
    margin: 0;
    font-size: 10.5px;
    color: rgba(170, 182, 205, 0.45);
    white-space: nowrap;
  }
  .foot a {
    color: rgba(170, 190, 225, 0.6);
  }
  .warp {
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(circle at 50% 50%, rgba(170, 200, 255, 0.35), rgba(3, 4, 10, 0) 60%);
  }
  .warp.go {
    animation: warp 0.7s ease-out;
  }
  @keyframes warp {
    0% {
      opacity: 0;
      transform: scale(0.6);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: scale(1.8);
    }
  }
  .fallback {
    position: fixed;
    inset: auto 0 45% 0;
    text-align: center;
  }
  .fallback a {
    color: #86b6ef;
  }
  @media (max-width: 560px) {
    .brand span {
      display: none;
    }
    .foot {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .warp.go {
      animation: none;
    }
  }
</style>
